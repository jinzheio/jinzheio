---
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class={`@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6 ${className ?? ""}`}>
  <slot />
</div>
