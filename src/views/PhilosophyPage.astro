---
import Ambient from "@/components/ambient.astro";
import PhilosophyAccordion from "@/components/philosophy-accordion.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import Badge from "@/components/ui/badge.astro";
import ButtonLink from "@/components/button-link.astro";
import Card from "@/components/ui/card.astro";
import CardHeader from "@/components/ui/card-header.astro";
import CardTitle from "@/components/ui/card-title.astro";
import CardContent from "@/components/ui/card-content.astro";
import Separator from "@/components/ui/separator.astro";
import { siteCopy } from "@/content/site-copy";

const t = siteCopy.philosophy;
const common = siteCopy.common;
---

<div class="min-h-screen">
  <Ambient />
  <SiteHeader />
  <main class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-6 pb-20 pt-16">
    <section class="space-y-6 animate-in fade-in slide-in-from-bottom-6 duration-700">
      <Badge class="rounded-full bg-mist text-xs uppercase tracking-[0.3em] text-graphite">
        {t.badge}
      </Badge>
      <h1 class="font-display text-4xl text-graphite md:text-5xl">
        {t.title}
        {t.titleContinued && (
          <>
            <br />
            {t.titleContinued}
          </>
        )}
      </h1>
      <p class="max-w-2xl text-base text-muted-foreground">
        {t.description}
      </p>
      <div class="flex flex-wrap gap-3">
        <ButtonLink href="/projects" class="bg-graphite text-xs uppercase tracking-[0.3em] text-white">
          {t.projectsIndex}
        </ButtonLink>
        <ButtonLink variant="outline" href="/projects/commanddeck" class="border-border/60 bg-transparent text-xs uppercase tracking-[0.3em] text-graphite hover:bg-graphite hover:text-white">
          {t.commanddeck}
        </ButtonLink>
      </div>
    </section>

    <Separator />

    <section class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] animate-in fade-in slide-in-from-bottom-6 duration-700">
      <div class="space-y-6">
        <p class="text-xs uppercase tracking-[0.4em] text-muted-foreground">
          {t.coreThreads}
        </p>
        <h2 class="font-display text-3xl text-graphite md:text-4xl">
          {t.subtitle}
        </h2>
        <p class="text-base text-muted-foreground">
          {t.summary}
        </p>
        <PhilosophyAccordion />
      </div>
      <div class="space-y-6">
        <Card class="surface-glass border-border/60">
          <CardHeader>
            <CardTitle class="font-display text-2xl text-graphite">
              {common.rituals}
            </CardTitle>
          </CardHeader>
          <CardContent class="space-y-4 text-sm text-muted-foreground">
            {t.practices.map((practice) => (
              <div class="space-y-1">
                <p class="text-graphite">{practice.title}</p>
                <p>{practice.description}</p>
              </div>
            ))}
          </CardContent>
        </Card>
        <Card class="border-border/60 bg-card/80">
          <CardHeader>
            <CardTitle class="font-display text-2xl text-graphite">
              {common.signals}
            </CardTitle>
          </CardHeader>
          <CardContent class="space-y-2 text-sm text-muted-foreground">
            {t.signals.map((signal) => (
              <p class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-ember"></span>
                <span>{signal}</span>
              </p>
            ))}
          </CardContent>
        </Card>
      </div>
    </section>
  </main>
  <SiteFooter />
</div>
