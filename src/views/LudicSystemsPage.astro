---
import Ambient from "@/components/ambient.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import Badge from "@/components/ui/badge.astro";
import ButtonLink from "@/components/button-link.astro";
import Card from "@/components/ui/card.astro";
import CardHeader from "@/components/ui/card-header.astro";
import CardTitle from "@/components/ui/card-title.astro";
import CardContent from "@/components/ui/card-content.astro";
import Separator from "@/components/ui/separator.astro";
import { siteCopy } from "@/content/site-copy";

const t = siteCopy.ludic;
const common = siteCopy.common;
const moduleKeys = ["whitepaper", "protocol", "engine", "lab", "community"] as const;
const nodes = [
  {
    key: "jinzheio",
    title: t.dualNode.jinzheio.title,
    points: t.dualNode.jinzheio.points,
  },
  {
    key: "ludicSystems",
    title: t.dualNode.ludicSystems.title,
    points: t.dualNode.ludicSystems.points,
  },
];
---

<div class="min-h-screen">
  <Ambient />
  <SiteHeader />
  <main class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-6 pb-20 pt-16">
    <section class="space-y-6 animate-in fade-in slide-in-from-bottom-6 duration-700">
      <Badge class="rounded-full bg-mist text-xs uppercase tracking-[0.3em] text-graphite">
        {t.badge}
      </Badge>
      <h1 class="font-display text-4xl text-graphite md:text-5xl">
        {t.title}
      </h1>
      <p class="max-w-2xl text-base text-muted-foreground">
        {[t.subtitle, t.description].filter(Boolean).join(". ")}
      </p>
      {t.positioning && (
        <p class="max-w-2xl text-sm text-muted-foreground">
          {t.positioning}
        </p>
      )}
      <div class="flex flex-wrap gap-3">
        <ButtonLink href="/projects/commanddeck" class="bg-graphite text-xs uppercase tracking-[0.3em] text-white">
          {t.commanddeck}
        </ButtonLink>
        <ButtonLink variant="outline" href="/projects" class="border-border/60 bg-transparent text-xs uppercase tracking-[0.3em] text-graphite hover:bg-graphite hover:text-white">
          {t.backToProjects}
        </ButtonLink>
      </div>
    </section>

    <Separator />

    <section class="grid gap-6 md:grid-cols-2 animate-in fade-in slide-in-from-bottom-6 duration-700">
      {nodes.map((node) => (
        <Card class="border-border/60 bg-card/80">
          <CardHeader>
            <CardTitle class="font-display text-2xl text-graphite">
              {node.title}
            </CardTitle>
          </CardHeader>
          <CardContent class="space-y-3 text-sm text-muted-foreground">
            {node.points.map((point) => (
              <div class="flex items-start gap-2">
                <span class="mt-1 size-1.5 rounded-full bg-brand"></span>
                <span>{point}</span>
              </div>
            ))}
          </CardContent>
        </Card>
      ))}
    </section>

    <section class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] animate-in fade-in slide-in-from-bottom-6 duration-700">
      <Card class="surface-glass border-border/60">
        <CardHeader>
          <CardTitle class="font-display text-2xl text-graphite">
            {common.modules}
          </CardTitle>
        </CardHeader>
        <CardContent class="space-y-4 text-sm text-muted-foreground">
          {moduleKeys.map((key) => {
            const item = t.modules[key];
            return (
              <div class="space-y-1">
                <p class="text-graphite">{item.title}</p>
                <p>{item.description}</p>
              </div>
            );
          })}
        </CardContent>
      </Card>
      <Card class="border-border/60 bg-card/80">
        <CardHeader>
          <CardTitle class="font-display text-2xl text-graphite">
            {common.principles}
          </CardTitle>
        </CardHeader>
        <CardContent class="space-y-3 text-sm text-muted-foreground">
          {t.principles.items.map((item) => (
            <div class="flex items-start gap-2">
              <span class="mt-1 size-1.5 rounded-full bg-ember"></span>
              <span>{item}</span>
            </div>
          ))}
        </CardContent>
      </Card>
    </section>
  </main>
  <SiteFooter />
</div>
